# ┌───────────────────────────────────────────────────────────────┐
# │  .env.example → kopyalayıp `.env` oluşturun ve GERÇEK değerlerle │
# │  doldurun. Placeholder değerlerle uygulama BAŞLAMAZ (fail-close).│
# └───────────────────────────────────────────────────────────────┘

# ──── Ortam ────
# production → güvenlik kontrolleri sıkı (HTTPS uyarısı, vb.)
ENVIRONMENT=production

# ──── Database ────
# Parolayı güçlü ve benzersiz seçin (örnek parola reddedilir).
POSTGRES_USER=iu_user
POSTGRES_PASSWORD=__DEGISTIRIN_guclu_bir_parola__
POSTGRES_DB=iu_cookies
DATABASE_URL=postgresql+asyncpg://iu_user:__DEGISTIRIN_guclu_bir_parola__@postgres:5432/iu_cookies

# ──── Redis ────
# Redis artık parola ile korunur. REDIS_URL parolayı içermelidir.
REDIS_PASSWORD=__DEGISTIRIN_guclu_bir_redis_parolasi__
REDIS_URL=redis://:__DEGISTIRIN_guclu_bir_redis_parolasi__@redis:6379/0
REDIS_SESSION_TTL=432000

# ──── JWT Auth ────
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=__DEGISTIRIN_en_az_32_karakter_rastgele__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──── Admin ────
# İki seçenekten biri:
#   1) ADMIN_PASSWORD  → düz parola (en az 10 karakter, placeholder olamaz)
#   2) ADMIN_PASSWORD_HASH → bcrypt hash (TERCİH EDİLEN — düz parola diskte tutulmaz)
#      Üretmek için: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('parolaniz'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__DEGISTIRIN_en_az_10_karakter__
# ADMIN_PASSWORD_HASH=

# ──── Captcha (opsiyonel · CapSolver) ────
# TERCİH EDİLEN: anahtarı PANELDEN gir (⚙️ Kullanıcı Ayarları → Captcha) → redis'te maskeli saklanır.
# Buradaki .env değeri yalnızca panelde anahtar YOKSA yedek olarak kullanılır.
CAPTCHA_API_KEY=
CAPTCHA_SERVICE=capsolver

# ──── Credential at-rest encryption (opsiyonel) ────
# Boş = devre dışı (gmail.csv düz metin okunur).
# Etkinleştirme: python3 encrypt_csv.py --genkey → gmail.csv'yi şifrele → düz metni sil →
# bu anahtarı RUNTIME'da inject et (secret manager / docker secret). Diske YAZMA.
CREDENTIAL_KEY=

# ──── Farming ────
DEFAULT_FARMING_MODE=SAFE
MAX_CONCURRENT_BATCHES=3
TURBO_WORKER_COUNT=80
FAST_WORKER_COUNT=10
SAFE_WORKER_COUNT=3
MASTER_SESSION_REFRESH_MINUTES=90
CHECKPOINT_INTERVAL=100
# DRY_RUN=true → gerçek tarayıcı/Google login OLMADAN tüm pipeline'ı test et (sentetik cookie).
DRY_RUN=false

# ──── Playwright ────
PLAYWRIGHT_BROWSER=chromium
BROWSER_POOL_SIZE=10
HEADLESS=true
# false (varsayılan) → Chromium sandbox AÇIK; container desteklemezse otomatik
# --no-sandbox'a düşer (güvenli, farming kırılmaz). Zorla kapatmak için true.
BROWSER_NO_SANDBOX=false

# ──── Proxy ────
DEFAULT_PROXY_LOCATION=TR

# ──── TLS / Anti-detect ────
CURL_CFFI_IMPERSONATE=chrome120
STEALTH_ENABLED=true

# ──── Telegram Alerts (optional) ────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──── SMS 2FA (optional) ────
SMS_API_KEY=
SMS_SERVICE=5sim

# ──── Disk Monitoring ────
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90

# ──── Uploads ────
MAX_UPLOAD_BYTES=10485760

# ──── Paths ────
COOKIES_OUTPUT_DIR=./cookies_output
LOG_DIR=./logs

# ──── CORS (wildcard '*' KULLANILAMAZ) ────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
